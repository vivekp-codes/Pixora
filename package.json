{
  "name": "print-lab",
  "version": "1.0.0",
  "description": "A free, fullstack text-to-image generator (Express + React/Vite, single folder) using Pollinations.ai",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev:server": "node server.js",
    "dev:client": "vite",
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cloudinary": "^2.10.0",
    "express": "^4.19.2",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.2.2",
    "vite": "^8.2.0"
  }
}
